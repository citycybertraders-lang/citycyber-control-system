    },
    "profit": {
      "allow_low_margin": false,
      "min_margin_pct": 20.0,
      "bias": "margin"
    },
    "bundle": {
      "allow_low_margin": true,
      "min_margin_pct": 8.0,
      "bias": "pair_optimise"
    }
  }
}
